{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CoreApiClient" :  {
    "ApiConfig" : {
      "BaseAddressUrl": "api-core-bingo.esatpt.com",
      "Policies": {
        "HttpCircuitBreaker": {
          "DurationOfBreak": "00:01:00",
          "ExceptionsAllowedBeforeBreaking": 20
        },
        "HttpRetry": {
          "BackoffPower": 2,
          "Count": 3
        }
      },
      "Logging": {
        "Enabled": true,
        "MaxBodySize": 2048
      }
    }
  },
